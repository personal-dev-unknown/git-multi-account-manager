# Git Manager — Environment Configuration Template
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# Database connection (MySQL for production)
# Format: mysql://user:password@host:port/database
GIT_MANAGER_DB_URL=mysql://root:root@localhost/git_manager

# SQLite override (development/testing only)
# Uncomment to use SQLite instead of MySQL
# GIT_MANAGER_SQLITE_PATH=./dev.db

# Log level: error, warn, info, debug, trace
RUST_LOG=info

# Web interface bind address
GIT_MANAGER_WEB_ADDR=127.0.0.1:5008

# Dynamic plugin directory (optional)
# GIT_MANAGER_PLUGIN_DIR=/opt/gm-plugins
